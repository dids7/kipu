rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tripId} {

      // Funções auxiliares — descobrem o papel do usuário logado dentro
      // desta viagem, a partir dos dados que já foram lidos pela regra.
      function roleFrom(tripData) {
        return !("participantRoles" in tripData)
          ? "admin"
          : (request.auth.token.email in tripData.participantRoles
              ? tripData.participantRoles[request.auth.token.email]
              : "colaborador");
      }
      function parentTrip() {
        return get(/databases/$(database)/documents/trips/$(tripId)).data;
      }
      function roleIn() {
        return roleFrom(parentTrip());
      }
      function isParticipant() {
        return request.auth.token.email in parentTrip().participantEmails;
      }

      // Criar: qualquer usuário autenticado pode criar uma viagem nova
      // (ele já nasce Admin dela, definido no próprio app).
      allow create: if request.auth != null;

      // "get" (buscar 1 viagem pelo ID/código): qualquer usuário autenticado
      // pode buscar, mesmo sem ainda ser participante — é assim que o código
      // de convite funciona (precisa achar a viagem antes de entrar nela).
      allow get: if request.auth != null;

      // "list" (tela "Suas viagens"): só retorna viagens onde o e-mail do
      // usuário já está na lista de participantes.
      allow list: if request.auth != null
        && request.auth.token.email in resource.data.participantEmails;

      // Excluir a viagem: só Admin.
      allow delete: if request.auth != null && roleFrom(resource.data) == "admin";

      // Editar dados da viagem (nome/datas/participantes/papéis/etc):
      // Admin e Colaborador podem editar livremente. Agência e Convidado
      // não editam o documento da viagem em si. Um NÃO-participante só
      // pode escrever se for exatamente a auto-entrada por código de
      // convite (adicionando o próprio e-mail, com o papel padrão
      // configurado pela viagem).
      allow update: if request.auth != null && (
        roleFrom(resource.data) == "admin" ||
        roleFrom(resource.data) == "colaborador" ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantEmails", "participantRoles"]) &&
          request.auth.token.email in request.resource.data.participantEmails &&
          !(request.auth.token.email in resource.data.participantEmails) &&
          request.resource.data.participantRoles[request.auth.token.email] == resource.data.defaultJoinRole
        )
      );

      // ---- Calendário / Itinerário / Estadia ----
      // Admin, Colaborador e Agência editam. Convidado só lê (o "adicionar
      // lembrete" dele acontece na subcoleção separada "lembretes").
      match /itinerario/{docId} {
        allow read: if request.auth != null && isParticipant();
        allow write: if request.auth != null && isParticipant() && roleIn() in ["admin", "colaborador", "agencia"];
      }
      match /estadia/{docId} {
        allow read: if request.auth != null && isParticipant();
        allow write: if request.auth != null && isParticipant() && roleIn() in ["admin", "colaborador", "agencia"];
      }
      match /lembretes/{docId} {
        allow read: if request.auth != null && isParticipant();
        allow write: if request.auth != null && isParticipant() && roleIn() in ["admin", "colaborador", "agencia", "convidado"];
      }

      // ---- Mala ----
      // Admin/Colaborador editam tudo. Convidado só mexe nos PRÓPRIOS itens.
      // Agência não tem acesso nenhum (nem leitura).
      match /mala/{docId} {
        allow read: if request.auth != null && isParticipant() && roleIn() != "agencia";
        allow create: if request.auth != null && isParticipant() && (
          roleIn() in ["admin", "colaborador"] ||
          (roleIn() == "convidado" && request.resource.data.ownerEmail == request.auth.token.email)
        );
        allow update: if request.auth != null && isParticipant() && (
          roleIn() in ["admin", "colaborador"] ||
          (roleIn() == "convidado" && resource.data.ownerEmail == request.auth.token.email)
        );
        allow delete: if request.auth != null && isParticipant() && (
          roleIn() in ["admin", "colaborador"] ||
          (roleIn() == "convidado" && resource.data.ownerEmail == request.auth.token.email)
        );
      }

      // ---- Tarefas ----
      // Admin/Colaborador/Convidado editam (Convidado marca como feita).
      // Agência sem acesso.
      match /tarefas/{docId} {
        allow read: if request.auth != null && isParticipant() && roleIn() != "agencia";
        allow write: if request.auth != null && isParticipant() && roleIn() in ["admin", "colaborador", "convidado"];
      }

      // ---- Documentos / Gastos / Emergência ----
      // Admin/Colaborador/Convidado editam. Agência sem acesso nenhum.
      match /documentos/{docId} {
        allow read, write: if request.auth != null && isParticipant() && roleIn() in ["admin", "colaborador", "convidado"];
      }
      match /gastos/{docId} {
        allow read, write: if request.auth != null && isParticipant() && roleIn() in ["admin", "colaborador", "convidado"];
      }
      match /emergencia/{docId} {
        allow read, write: if request.auth != null && isParticipant() && roleIn() in ["admin", "colaborador", "convidado"];
      }

      // ---- Histórico ----
      // Todo mundo que faz alguma ação pode registrar uma entrada nova.
      // Leitura: todos, menos Agência. Nunca dá pra editar um registro já
      // existente. Apagar em massa (reset) é exclusivo do Admin.
      match /activityLog/{docId} {
        allow read: if request.auth != null && isParticipant() && roleIn() != "agencia";
        allow create: if request.auth != null && isParticipant();
        allow update: if false;
        allow delete: if request.auth != null && isParticipant() && roleIn() == "admin";
      }
    }

    // Perfis de usuário (nome de exibição). O ID do documento é o próprio
    // e-mail. Qualquer usuário logado pode LER qualquer perfil (precisa
    // pra mostrar o nome de outros participantes), mas só pode ESCREVER
    // no próprio perfil.
    match /users/{userEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == userEmail;
    }
  }
}
