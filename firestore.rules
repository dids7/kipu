rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção de viagens: qualquer usuário autenticado pode criar uma viagem
    // e listar as viagens onde o e-mail dele está na lista de participantes.
    match /trips/{tripId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null
        && request.auth.token.email in resource.data.participantEmails;

      // Todas as subcoleções (itinerario, estadia, passeios, documentos, mala,
      // tarefas, gastos, emergencia, activityLog) seguem a mesma regra:
      // só participantes da viagem-pai podem ler/escrever.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.token.email in get(/databases/$(database)/documents/trips/$(tripId)).data.participantEmails;
      }
    }
  }
}
